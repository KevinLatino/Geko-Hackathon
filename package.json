{
  "name": "scaffold-stellar-frontend",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "concurrently \"stellar scaffold watch --build-clients\" \"vite\"",
    "start": "concurrently \"stellar scaffold watch --build-clients\" \"vite\"",
    "build": "tsc -b && vite build",
    "install:contracts": "npm install --workspace=packages && npm run build --workspace=packages",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier . --write",
    "prepare": "husky",
    "pool:deploy": "tsx src/blend/pool/deploy-pool.ts",
    "pool:status": "tsx src/blend/pool/set-status.ts",
    "pool:update-status": "tsx src/blend/pool/update-status.ts",
    "pool:distribute": "tsx src/blend/pool/distribute.ts",
    "pool:revoke-admin": "tsx src/blend/pool/revoke-admin.ts",
    "pool:verify": "tsx src/blend/pool/verify-pool.ts",
    "envelopes:deploy": "tsx src/geko-envelopes/deploy-envelopes.ts",
    "token:deploy": "tsx src/geko-token/deploy-token.ts",
    "nft:deploy": "tsx src/geko-nft/deploy-nft.ts",
    "nft:admin-mint": "tsx src/geko-nft/admin-mint.ts"
  },
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@blend-capital/blend-sdk": "^3.2.1",
    "@creit.tech/stellar-wallets-kit": "^1.9.5",
    "@moonpay/moonpay-js": "^0.7.5",
    "@moonpay/moonpay-react": "^1.10.5",
    "@stellar/design-system": "^3.1.5",
    "@stellar/stellar-sdk": "^14.2.0",
    "@stellar/stellar-xdr-json": "^23.0.0",
    "@tanstack/react-query": "^5.90.2",
    "@types/node-fetch": "^2.6.13",
    "form-data": "^4.0.4",
    "framer-motion": "^12.23.24",
    "geko_envelopes": "^0.0.0",
    "lossless-json": "^4.2.0",
    "lucide-react": "^0.553.0",
    "node-fetch": "^3.3.2",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.3",
    "tailwind-merge": "^3.3.1",
    "three": "^0.181.0",
    "tw-merge": "^0.0.1-alpha.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/lodash": "^4.17.20",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/react-router-dom": "^5.3.3",
    "@types/three": "^0.181.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-dom": "^2.0.3",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "eslint-plugin-react-x": "^2.0.3",
    "glob": "^11.0.3",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.3",
    "postcss": "^8.5.6",
    "prettier": "3.6.2",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.19.2",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.11",
    "vite-plugin-node-polyfills": "^0.24.0",
    "vite-plugin-wasm": "^3.5.0"
  },
  "lint-staged": {
    "**/*": [
      "eslint --fix --no-warn-ignored",
      "prettier --write --ignore-unknown"
    ]
  }
}
